46197a292c" class=3D"confluenceTable">
<tbody>
<tr data-local-id=3D"40afc0d38d5e">
<th data-local-id=3D"4dbd0c63644a" class=3D"confluenceTh">
<p local-id=3D"5b6f4acbd208">Column</p></th>
<th data-local-id=3D"01a1825501c1" class=3D"confluenceTh">
<p local-id=3D"3a227959e972">Type / Constraint</p></th>
