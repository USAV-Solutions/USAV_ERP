<p local-id=3D"4dc0d8f5bb9d">Description</p></th>
</tr>
<tr data-local-id=3D"4c4e2041d2bb">
<td data-local-id=3D"42a7ae855e79" class=3D"confluenceTd">
<p local-id=3D"0b5ec1b6a26d">id</p></td>
<td data-local-id=3D"22cf4f48189e" class=3D"confluenceTd">
<p local-id=3D"b9e828d69bb5">BIGINT PK</p></td>
<td data-local-id=3D"0a0075d74604" class=3D"confluenceTd">
<p local-id=3D"b0bde0c87779">Auto-increment.</p></td>
</tr>
